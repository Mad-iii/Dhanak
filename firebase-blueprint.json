{
  "entities": {
    "Review": {
      "title": "Product Review",
      "description": "A customer review for a specific product",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "The ID of the product being reviewed" },
        "userName": { "type": "string", "description": "Display name of the reviewer" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5, "description": "Star rating from 1 to 5" },
        "text": { "type": "string", "description": "Content of the review" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the review was submitted" }
      },
      "required": ["productId", "userName", "rating", "text", "createdAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of product reviews"
    }
  }
}
